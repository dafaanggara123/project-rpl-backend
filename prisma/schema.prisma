generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// Tambahkan kode ini ke bawah
model Booking {
  id       String @id @default(uuid())
  room     String
  date     String
  time     String
  bookedBy String
  status   String // 'Available' atau 'Booked'
}