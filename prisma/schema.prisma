generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

//model login user
model User {
  id        Int      @id @default(autoincrement())
  name      String
  email     String   @unique
  password  String
  role      String   @default("user")
  createdAt DateTime @default(now())  
}

// Tambahkan kode ini ke bawah
model Booking {
  id       String @id @default(uuid())
  room     String
  date     String
  time     String
  bookedBy String
  status   String // 'Available' atau 'Booked'
}